N8N_WEBHOOK_URL=https://automacao.example.com/webhook/xxxx/chat
N8N_TIMEOUT_MS=300000

# OpenAI TTS (áudio) — SERVER ONLY, nunca prefixe com NEXT_PUBLIC_
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-audio-1.5
OPENAI_TTS_VOICE=verse
# opções que soam mais humanas em PT-BR: verse, coral, sage, cedar, ballad
# outras: marin (mais neutra), alloy, ash, echo, shimmer
# OPENAI_TTS_SYSTEM_PROMPT pode ser sobrescrito via env se quiser afinar
OPENAI_TTS_TIMEOUT_MS=60000

# Threshold: mensagens de texto puro acima disso viram áudio
NEXT_PUBLIC_AUDIO_THRESHOLD_CHARS=180
